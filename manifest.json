{
  "manifest_version": 3,
  "name": "Calculateur de Notes GEA",
  "version": "1.0",
  "description": "Calcule la moyenne pondérée directement sur le bulletin de l'ENT.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://signatures.unilim.fr/*"
      ],
      "js": ["content.js"]
    }
  ]
}
